# Codev
.agent-farm/
.consult/
codev/.update-hashes.json
.builders/
.architect-role.md
codev/state/*.md
!codev/state/*_thread.md

# Raw sources held back pending licensing (public repo — see texts/README.md).
# The restricted PAYLOADS are git-ignored and local-only, but each source.yaml IS
# committed so the catalogue stays complete and auditable (see pipelines/sacredbench/catalogue.py).
# NABRE: copyrighted translation (Confraternity of Christian Doctrine / USCCB)
texts/raw/Roman Catholic/nabre.json
# TLG corpus extracts (licensed TLG corpus; Rahlfs/NA editions copyrighted):
# ignore every payload under Greek Orthodox but keep its committed source.yaml.
texts/raw/Greek Orthodox/*
!texts/raw/Greek Orthodox/source.yaml

# Standardized corpora are rebuilt locally from texts/raw (never committed)
texts/standardized/
# Assembled interchange documents are rebuilt locally from texts/standardized
texts/interchange/

# Legacy pre-two-tier converted corpora (superseded by texts/raw + texts/standardized)
texts/bible-nabre.json
texts/encyclicals/

# Run outputs are rebuilt locally — EXCEPT the first committed benchmark run,
# whose copyright-audited evidence is the loop-closure deliverable (Spec 1 Phase 8).
runs/*
!runs/first-run-2026-10-11/
!runs/tutorial-2026-10-11/
!runs/original-2026-10-21/

# Live model panel (keys come from env, panel is per-user)
configs/models.yaml

# Python
pipelines/.venv/
__pycache__/
*.pyc

# Viewer app
apps/viewer/node_modules/
apps/viewer/dist/

# Local secrets (keys come from env; never commit). .env.example is the committed name list.
.env
.env.*
!.env.example

# Local FAccT manuscript and its PDF (not part of the public repo).
.papers/
