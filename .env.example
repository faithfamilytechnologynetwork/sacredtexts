# Copy to .env and fill only the keys your panel uses. .env is gitignored.
# sacredbench reads these from the environment. It never reads this file itself.
# Do not put a real key in .env.example.

# Direct Anthropic (configs/models.example.yaml: web_search panel).
ANTHROPIC_API_KEY=

# OpenAI-compatible hosts. OpenRouter models (configs/models.openrouter.yaml) use this name.
OPENROUTER_API_KEY=

# Only if a panel entry sets api_key_env: OPENAI_API_KEY (api.openai.com).
OPENAI_API_KEY=

# Only if a panel entry uses provider: gemini.
GEMINI_API_KEY=
