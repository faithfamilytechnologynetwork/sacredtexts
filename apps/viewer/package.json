{
  "name": "viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "24.x"
  },
  "description": "Browse & explore the Sacred Texts benchmark - a local-only SPA that reads run artifacts (summary/scores/answers/questions) and renders a leaderboard, error explorer, and cross-run standings.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "@hono/node-server": "^1.13.7",
    "@tanstack/react-router": "^1.141.1",
    "hono": "^4.6.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "vitest": "^3.2.1"
  }
}
