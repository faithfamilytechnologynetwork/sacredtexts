# SacredBench review API (apps/api), Spec 154.
#
# This service holds secrets (the database URL and the invite code). They come from the
# environment only and never reach the viewer bundle. Relative paths resolve against the
# directory the service starts in (apps/api, under `pnpm -C apps/api start`).

# Postgres connection string. Required: the server and the migrator exit if it is unset.
DATABASE_URL=postgres://localhost:5432/sacredtexts_review_dev

# The committed review sample this deployment serves. Required: the server exits if it is unset,
# unreadable, or not a format-1 sample. Drafts and submissions are accepted for this sample only.
SAMPLE_PATH=../../review/samples/facct-2026-11-03-k10.json

# The built viewer (`pnpm -C apps/viewer build`). Optional: when set, the service serves it beside
# /api with a history fallback to index.html, and exits if its index.html is missing. Unset ⇒ API
# only (local dev behind the Vite proxy).
VIEWER_DIST=../viewer/dist

# Comma-separated browser origins allowed to make credentialed cross-origin requests. The review
# UI is served from the same origin as /api, so an empty list is correct; list an origin only for
# a separate dev server (e.g. the Vite dev server). Never use "*" with credentials.
ALLOWED_ORIGINS=

# Port the service listens on. Defaults to 8080.
PORT=8080

# Shared signup invite code. Reviewers must present it to create an account. FAIL-CLOSED: if it
# is unset, signup is disabled entirely (login still works).
REVIEW_INVITE_CODE=change-me
