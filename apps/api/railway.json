{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm -C apps/viewer install --frozen-lockfile && pnpm -C apps/viewer build && pnpm -C apps/api install --frozen-lockfile"
  },
  "deploy": {
    "preDeployCommand": "pnpm -C apps/api migrate",
    "startCommand": "pnpm -C apps/api start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
